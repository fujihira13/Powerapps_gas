<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net462</TargetFramework><LangVersion>7.3</LangVersion>
    <AssemblyName>PowerappsGas.EnvironmentManagement</AssemblyName>
    <AutomaticallyUseReferenceAssemblyPackages>false</AutomaticallyUseReferenceAssemblyPackages>
    <SignAssembly Condition="'$(SigningKeyPath)' != ''">true</SignAssembly>
    <AssemblyOriginatorKeyFile>$(SigningKeyPath)</AssemblyOriginatorKeyFile>
    <DataverseSdkAssemblyPath Condition="'$(DataverseSdkAssemblyPath)' == ''">$(DATAVERSE_SDK_ASSEMBLY_PATH)</DataverseSdkAssemblyPath>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.CrmSdk.CoreAssemblies" Version="9.0.2.60" />
    <Reference Include="System.Runtime.Serialization" /><Reference Include="System.ServiceModel" />
  </ItemGroup>
</Project>
