{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mq-id-input.v1.schema.json",
  "title": "MQ ID comparison input",
  "type": "object",
  "required": ["contract_version", "batch_input", "log_text"],
  "properties": {
    "contract_version": { "const": "mq-id-input.v1" },
    "case_name": { "type": "string" },
    "batch_input": {
      "type": "object",
      "required": ["sheets"],
      "properties": {
        "sheets": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "rows"],
            "properties": {
              "name": { "type": "string" },
              "rows": {
                "type": "array",
                "items": {
                  "type": "array",
                  "items": {
                    "type": ["string", "number", "boolean", "null"]
                  }
                }
              }
            }
          }
        }
      }
    },
    "log_text": { "type": "string" }
  }
}
